diff --git a/code-glassvrdriver/HmdVr/devices/hand_simulation.cpp b/code-glassvrdriver/HmdVr/devices/hand_simulation.cpp
index 0f6844c..f76c069 100644
--- a/code-glassvrdriver/HmdVr/devices/hand_simulation.cpp
+++ b/code-glassvrdriver/HmdVr/devices/hand_simulation.cpp
@@ -260,6 +260,32 @@ void MyHandSimulation::ComputeSkeletonTransforms(vr::ETrackedControllerRole role
 	ApplyGenericFingerTransform(curls.ring, splays.ring, hand.fingers[2]);
 	ApplyGenericFingerTransform(curls.pinky, splays.pinky, hand.fingers[3]);
 
-	// Now compute
+	// Now compute all articulated bones.
 	ComputeSkeletalTransforms(hand, out_transforms);
+
+	// Auxiliary bones are fingertip transforms relative to root (parent 0),
+	// not finger-local transforms. Home uses these for hand animation.
+	const int parents[26] = {-1,0,1,2,3,4,1,6,7,8,9,1,11,12,13,14,1,16,17,18,19,1,21,22,23,24};
+	vr::HmdQuaternion_t rotations[26];
+	vr::HmdVector3_t positions[26];
+	for (int i = 0; i < 26; ++i) {
+		const auto& b = out_transforms[i];
+		vr::HmdQuaternion_t q = {b.orientation.w,b.orientation.x,b.orientation.y,b.orientation.z};
+		vr::HmdVector3_t p = {b.position.v[0],b.position.v[1],b.position.v[2]};
+		if (parents[i] >= 0) {
+			const int parent = parents[i];
+			p = p * rotations[parent];
+			for (int axis = 0; axis < 3; ++axis) p.v[axis] += positions[parent].v[axis];
+			q = rotations[parent] * q;
+		}
+		rotations[i] = q;
+		positions[i] = p;
+	}
+	const int tips[5] = {5,10,15,20,25};
+	for (int finger = 0; finger < 5; ++finger) {
+		auto& aux = out_transforms[26 + finger];
+		HmdQuaternion_ConvertQuaternion(rotations[tips[finger]], aux.orientation);
+		HmdVector3_CovertVector(positions[tips[finger]], aux.position);
+		aux.position.v[3] = 1.f;
+	}
 }
